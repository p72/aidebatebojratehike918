# 議題の設定。scripts/*.sh は source し、scripts/*.py は scripts/topic.py で読む。
# 1行に KEY='値'。画面で改行したいところは「｜」で区切る。

# 議題（相手のモデルに渡す）と、ファクトチェックで使う短い言い方
MOTION='高市政権は2026年10月9日、2027年4月から2年間、飲食料品の消費税率を8%から1%に引き下げる法案を閣議決定した。この消費税減税に賛成か、反対か。リフレ派と反リフレ派の対決です。'
SUBJECT='飲食料品の消費税を2年間1%に下げる減税の是非（リフレ派と反リフレ派の対決）'

# 相手のモデル（話者名にも使う）と読み
ASTRA_MODEL='gpt-6-astra'
ASTRA_READING='ジーピーティーシックス アストラ'

# 立場。*_SIDE は相手への指示、*_ROLE は台本、*_TAG は画面に出す
ASTRA_SIDE='反リフレ派として、この消費税減税に【反対】'
OPUS_SIDE='リフレ派として、減税に【賛成】'
ASTRA_ROLE='反リフレ派・減税に反対'
OPUS_ROLE='リフレ派・減税に賛成'
ASTRA_TAG='反リフレ派'
OPUS_TAG='リフレ派'

# 相手の1発言の長さ
LENGTH='330〜370字'

# 出力するファイルの名前
ARTICLE='debate3_food_tax.md'
SCRIPT='script3_food_tax'
VIDEO='food_tax_debate3'

# 動画のタイトル画面と最後の画面
TITLE_KICKER='AI vs AI ガチ討論　リフレ派 vs 反リフレ派'
TITLE='食料品の消費税1%は｜正しいのか？'
END='相互ファクトチェック｜（討論のあとに記入）'

# 台本のテロップとナレーション（ナレーションは読み上げ用の表記で書く）
TELOP_OPEN='AI vs AI ガチ討論／食料品の消費税1%は正しいのか？／リフレ派 vs 反リフレ派・ファクトシートなし'
TELOP_END='（討論のあとに記入）'
NARRATION_OPEN='（討論のあとに記入）'
NARRATION_CLOSE='（討論のあとに記入）'
